# NIRNAY Backend Environment Configuration
# Copy this file to .env and configure for local or staging deployment.
# NEVER commit secrets, passwords, or AWS Account IDs to version control.

# Application Environment
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated or JSON list)
ALLOWED_ORIGINS=*

# Geodata File Paths
HOTSPOTS_FILE=data/hotspots/hotspots.json
REPLAYS_FILE=data/rainfall/replays.json

# AWS Credentials (Optional for local testing; uses IAM role in Lambda/ECS)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Amazon Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_REGION=us-east-1
BEDROCK_TIMEOUT_SECONDS=15.0

# Amazon DynamoDB
DYNAMODB_TABLE_NAME=nirnay-scenarios

# Open-Meteo Weather API
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_CACHE_MINUTES=30
LAST_FORECAST_FILE=data/rainfall/last_forecast.json

# Monte Carlo Engine Configuration
MC_DRAWS=200
MC_SEED=42
MC_STABILITY_SUBSET_DRAWS=50

